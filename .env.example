# Base URL of the Neuron Sentinel backend API.
# Leave empty/unset during frontend-only development: every page keeps
# working from the bundled mock data in src/data/, and a small "MOCK" badge
# is shown wherever data would otherwise be silently fabricated.
# Once the backend (see /backend) is running, set e.g.:
# VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_BASE_URL=
